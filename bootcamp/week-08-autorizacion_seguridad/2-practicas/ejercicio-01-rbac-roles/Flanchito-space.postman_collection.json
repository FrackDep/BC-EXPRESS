        {
          "name": "Rotar access y refresh",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refreshToken={{refreshToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const previous = pm.collectionVariables.get('refreshToken');",
                  "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "for (const h of cookies) { const first = h.value.split(';')[0]; const i = first.indexOf('='); pm.collectionVariables.set(first.slice(0,i), first.slice(i+1)); }",
                  "pm.test('Access en cookie HttpOnly y SameSite', () => { const h = cookies.find(h => h.value.startsWith('accessToken=')); pm.expect(h).to.exist; pm.expect(h.value).to.include('HttpOnly'); pm.expect(h.value).to.include('SameSite=Lax'); pm.expect(h.value).to.include('Max-Age=900'); });",
                  "pm.test('No expone tokens ni password en JSON', () => { const b = pm.response.json(); pm.expect(b).not.to.have.property('password'); pm.expect(b).not.to.have.property('accessToken'); pm.expect(b).not.to.have.property('refreshToken'); });",
                  "pm.test('Refresh cookie 7 días', () => { const h = cookies.find(h => h.value.startsWith('refreshToken=')); pm.expect(h).to.exist; pm.expect(h.value).to.include('HttpOnly'); pm.expect(h.value).to.include('Path=/api/v1/auth'); pm.expect(h.value).to.include('Max-Age=604800'); });",
                  "pm.test('Refresh distinto al anterior', () => pm.expect(pm.collectionVariables.get('refreshToken')).not.to.eql(previous));",
                  "pm.collectionVariables.set('previousRefresh', previous);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh anterior ya consumido",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refreshToken={{previousRefresh}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout elimina ambas cookies",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cookies expiradas', () => { const values = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie'); pm.expect(values).to.have.lengthOf(2); values.forEach(h => pm.expect(h.value).to.include('Expires=Thu, 01 Jan 1970')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh revocado tras logout",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refreshToken={{refreshToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
