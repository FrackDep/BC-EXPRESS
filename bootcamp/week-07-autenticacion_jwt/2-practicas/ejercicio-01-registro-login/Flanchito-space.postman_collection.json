{
  "info": {
    "name": "Flanchito space · S07 · Ejercicio 01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar carpetas por separado. Semana 08 seguridad: reiniciar API local entre carpetas para ventanas nuevas; promover admin en MongoDB tras Registro. Ver README. Datos ficticios."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "memberEmail",
      "value": "franck@flanchito.test",
      "type": "string"
    },
    {
      "key": "memberPassword",
      "value": "FranckSpace!2026",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "spaceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Registro",
      "item": [
        {
          "name": "Registrar a Franck",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Franck\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Registro público user', () => pm.expect(pm.response.json().role).to.eql('user'));",
                  "pm.test('Sin password', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Miembro",
      "item": [
        {
          "name": "Login de Franck y cookies HttpOnly",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "for (const h of cookies) { const first = h.value.split(';')[0]; const i = first.indexOf('='); pm.collectionVariables.set(first.slice(0,i), first.slice(i+1)); }",
                  "pm.test('Access en cookie HttpOnly y SameSite', () => { const h = cookies.find(h => h.value.startsWith('accessToken=')); pm.expect(h).to.exist; pm.expect(h.value).to.include('HttpOnly'); pm.expect(h.value).to.include('SameSite=Lax'); pm.expect(h.value).to.include('Max-Age=900'); });",
                  "pm.test('No expone tokens ni password en JSON', () => { const b = pm.response.json(); pm.expect(b).not.to.have.property('password'); pm.expect(b).not.to.have.property('accessToken'); pm.expect(b).not.to.have.property('refreshToken'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil privado sin hashes",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin hashes', () => {pm.expect(pm.response.json()).not.to.have.property('password'); pm.expect(pm.response.json()).not.to.have.property('refreshToken');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil sin cookie",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
